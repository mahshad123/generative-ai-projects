# API key that clients must send to the FastAPI service (Authorization: Bearer <key>).
# Any non-empty string works for local development.
USER_API_KEY=change-me

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
DEFAULT_GOOGLE_MODEL="gemini-2.5-flash-lite"

# Optional: route Gemini calls through a custom endpoint/proxy
# GOOGLE_GEMINI_BASE_URL=https://your-proxy.example.com

# Model used as LLM-as-a-judge in evaluations (can be stronger than the model under test)
EVAL_JUDGE_MODEL="gemini-2.5-flash-lite"

# Times to repeat each eval case to measure LLM consistency (1 = quick, 5-10 = statistical confidence)
EVAL_NUM_REPEATS=5
